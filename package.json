{
  "name": "roshan-industries",
  "version": "1.0.0",
  "private": true,
  "description": "Static company website and product catalogue for Roshan Industries",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:content": "node tests/content-qa.cjs",
    "test:catalogue": "node tests/multipage-qa.cjs",
    "test:motion": "node tests/shared-motion-qa.cjs && node tests/hover-qa.cjs",
    "test:mobile": "node tests/mobile-qa.cjs",
    "test:anchors": "node tests/anchor-qa.cjs",
    "format": "prettier --write src scripts/*.mjs tests/**/*.cjs package.json README.md docs/*.md",
    "format:check": "prettier --check src scripts/*.mjs tests/**/*.cjs package.json README.md docs/*.md",
    "test:home": "node tests/root-navigation-qa.cjs",
    "test:sliders": "node tests/sliders-qa.cjs",
    "test:arrivals": "node tests/new-arrivals-qa.cjs",
    "export:xlsx": "node scripts/update-catalogues.mjs",
    "update:catalogues": "node scripts/update-catalogues.mjs",
    "test:source": "node tests/high-resolution-qa.cjs",
    "check:source": "node scripts/validate-high-resolution.mjs",
    "test:product-actions": "node tests/catalogue-actions-qa.cjs",
    "test:build": "node tests/fresh-build-qa.cjs",
    "test:online": "node tests/online-products-qa.cjs",
    "test": "node scripts/test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:images": "node tests/product-images-qa.cjs",
    "test:search": "node tests/search-suggestions-qa.cjs",
    "test:history": "node tests/browsing-return-qa.cjs",
    "test:cards": "node tests/whole-card-qa.cjs",
    "test:related": "node tests/related-slider-qa.cjs",
    "check:python": "python scripts/check-python.py",
    "test:pdf-images": "python tests/catalogue-image-cache-qa.py",
    "export:pdf": "node scripts/update-catalogues.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "prettier": "3.9.9"
  }
}
